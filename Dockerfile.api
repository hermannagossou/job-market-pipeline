FROM python:3.12-slim

# Évite les .pyc et force le flush des logs (utile pour voir les logs en direct
# dans docker compose).
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Installer les dépendances d'abord (couche Docker mise en cache tant que le
# requirements ne change pas).
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

# Copier le code de l'API. Le package s'appelle `api`, importé comme `api.main`.
COPY api ./api

EXPOSE 8000

# 0.0.0.0 pour être joignable depuis l'extérieur du conteneur (par Streamlit).
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
