            when source.niveau_experience is null then 'Non Renseigné'
            when source.niveau_experience like '%Débutant%' then 'Débutant'
            when regexp_contains(source.niveau_experience, r'\d+\s*Mois') then 'Débutant'
            when regexp_contains(source.niveau_experience, r'\d+\s*An\(s\)') then
                case
                    when safe_cast(regexp_extract(source.niveau_experience, r'(\d+)\s*An\(s\)') as int64) <= 2
