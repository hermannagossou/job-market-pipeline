# Copiez ce fichier en .env et remplissez les valeurs réelles.
# .env ne doit JAMAIS être commité (ajoutez-le à .gitignore).

# Projet et dataset BigQuery contenant les modèles marts (fact_offres, dim_*)
BQ_PROJECT_ID=votre-projet-gcp
BQ_DATASET=votre_dataset

# Chemin vers le fichier de credentials du service account.
# Laissez vide en local si vous utilisez `gcloud auth application-default login`.
GOOGLE_APPLICATION_CREDENTIALS=

# Origines autorisées en CORS pour Streamlit, séparées par des virgules dans le
# code si vous personnalisez cors_allow_origins (par défaut : toutes origines).
